#!/usr/bin/env python3
"""Validate and canonicalize a Needle JSONL dataset for the current gateway."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys
from typing import Any


ROOT = Path(__file__).resolve().parent.parent
SYSTEM_FACTS = "locale: it-IT; assistant: Sparkie"
sys.path.insert(0, str(ROOT))

from voice_gateway.local_responses import LocalResponseCatalog  # noqa: E402
from voice_gateway.policy import _value_errors  # noqa: E402
from voice_gateway.tool_catalog import ToolCatalog  # noqa: E402


def _dedup_key(row: dict[str, Any]) -> tuple[str, str]:
    return row["query"].strip().casefold(), json.dumps(row["answers"], sort_keys=True)


def _reasoning(query: str, answer: dict[str, Any] | None) -> str:
    if answer is None:
        return "Nessun tool dichiarato gestisce questa richiesta"
    if answer["name"] == "local_smalltalk":
        return f"{query!r} indica l'intento {answer['arguments']['intent']}"
    if answer["name"] == "get_battery_level":
        return "La richiesta parla di batteria, carica o autonomia"
    if answer["name"] == "navigate_to":
        return f"{answer['arguments']['location']!r} indica il luogo di destinazione"
    if answer["name"] == "set_volume":
        return f"La frase indica il livello di volume {answer['arguments']['level']}"
    return f"La richiesta riguarda {answer['name']}"


def _normalize(row: Any, tools: list[dict[str, Any]], responses: LocalResponseCatalog,
               specs: dict[str, dict[str, Any]]) -> tuple[dict[str, Any] | None, str | None]:
    if not isinstance(row, dict) or not isinstance(row.get("query"), str) or not row["query"].strip():
        return None, "query mancante o non valida"
    answers = row.get("answers", row.get("function_calls"))
    if not isinstance(answers, list) or len(answers) > 1:
        return None, "answers deve contenere al massimo una chiamata"
    answer: dict[str, Any] | None = None
    if answers:
        candidate = answers[0]
        if not isinstance(candidate, dict) or not isinstance(candidate.get("name"), str):
            return None, "chiamata non valida"
        spec = specs.get(candidate["name"])
        arguments = candidate.get("arguments")
        if spec is None or not isinstance(arguments, dict):
            return None, "tool o argomenti non validi"
        if _value_errors(arguments, spec["parameters"], "arguments"):
            return None, "argomenti fuori schema"
        if candidate["name"] == "local_smalltalk" and not responses.matches(
                row["query"], arguments["intent"]):
            return None, "frase smalltalk non ammessa dal catalogo locale"
        if candidate["name"] == "navigate_to" and arguments["location"].casefold() not in row["query"].casefold():
            return None, "destinazione non presente nella query"
        answer = {"name": candidate["name"], "arguments": arguments}
    return {
        "query": row["query"].strip(),
        "system": SYSTEM_FACTS,
        "tools": tools,
        "answers": [answer] if answer else [],
        "reasoning": _reasoning(row["query"].strip(), answer),
    }, None


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("inputs", type=Path, nargs="+",
                        help="One or more JSONL files to validate and merge.")
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    responses = LocalResponseCatalog(ROOT / "responses.it.json")
    catalogue = ToolCatalog(ROOT / "tools.json", responses.intents)
    tools = catalogue.needle_tools
    specs = {tool["name"]: tool for tool in tools}
    accepted: list[dict[str, Any]] = []
    rejected: dict[str, int] = {}
    seen = set()
    for input_path in args.inputs:
        for line in input_path.read_text(encoding="utf-8").splitlines():
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                rejected["JSON non valido"] = rejected.get("JSON non valido", 0) + 1
                continue
            normalized, reason = _normalize(row, tools, responses, specs)
            if normalized is None:
                rejected[reason or "riga non valida"] = rejected.get(reason or "riga non valida", 0) + 1
                continue
            key = _dedup_key(normalized)
            if key in seen:
                rejected["duplicato case-insensitive"] = rejected.get("duplicato case-insensitive", 0) + 1
                continue
            seen.add(key)
            accepted.append(normalized)
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(
        "".join(json.dumps(row, ensure_ascii=False, separators=(",", ":")) + "\n"
                for row in accepted), encoding="utf-8")
    print(f"Wrote {len(accepted)} valid rows to {args.output}")
    for reason, count in sorted(rejected.items()):
        print(f"Rejected {count}: {reason}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
