#!/usr/bin/env python3
"""Augment the Italian Sparkie seed until every declared class reaches its quota.

The script intentionally generates one class at a time: Gemini sees examples
only for the requested tool (or off-topic class), then every output row is
validated against the canonical gateway contract before it can be retained.
"""

from __future__ import annotations

import argparse
from collections import Counter
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
from typing import Any


ROOT = Path(__file__).resolve().parent.parent
SYSTEM_FACTS = "locale: it-IT; assistant: Sparkie"
GEMINI_ENDPOINT = "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions"
sys.path.insert(0, str(ROOT))

from voice_gateway.local_responses import LocalResponseCatalog  # noqa: E402
from voice_gateway.policy import _value_errors  # noqa: E402
from voice_gateway.tool_catalog import ToolCatalog  # noqa: E402


OFF_TOPIC = "off_topic"


def row_class(row: dict[str, Any]) -> str:
    answers = row.get("answers")
    if not answers:
        return OFF_TOPIC
    return answers[0]["name"]


def row_key(row: dict[str, Any]) -> tuple[str, str]:
    return row["query"].strip().casefold(), json.dumps(row["answers"], sort_keys=True)


def is_valid(row: Any, tools: list[dict[str, Any]], responses: LocalResponseCatalog,
             specs: dict[str, dict[str, Any]]) -> bool:
    if not isinstance(row, dict) or not isinstance(row.get("query"), str):
        return False
    if row.get("tools") != tools or not isinstance(row.get("answers"), list):
        return False
    if len(row["answers"]) > 1 or not isinstance(row.get("reasoning"), str):
        return False
    if not row["answers"]:
        return True
    answer = row["answers"][0]
    if not isinstance(answer, dict) or not isinstance(answer.get("name"), str):
        return False
    arguments = answer.get("arguments")
    spec = specs.get(answer["name"])
    if spec is None or not isinstance(arguments, dict):
        return False
    if _value_errors(arguments, spec["parameters"], "arguments"):
        return False
    if answer["name"] == "local_smalltalk":
        return responses.matches(row["query"], arguments["intent"])
    if answer["name"] == "navigate_to":
        return arguments["location"].casefold() in row["query"].casefold()
    return True


def load_jsonl(path: Path) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    for line_number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip():
            continue
        try:
            row = json.loads(line)
        except json.JSONDecodeError as exc:
            raise ValueError(f"{path}:{line_number}: JSON non valido") from exc
        if not isinstance(row, dict):
            raise ValueError(f"{path}:{line_number}: atteso oggetto JSON")
        rows.append(row)
    return rows


def load_distribution(path: Path, known_tools: set[str]) -> tuple[dict[str, int], int, int]:
    source = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(source, dict) or not isinstance(source.get("target_examples"), dict):
        raise ValueError("distribution.json richiede l'oggetto target_examples")
    targets: dict[str, int] = {}
    expected = known_tools | {OFF_TOPIC}
    for name, count in source["target_examples"].items():
        if name not in expected:
            raise ValueError(f"classe sconosciuta nella distribuzione: {name}")
        if not isinstance(count, int) or count < 0:
            raise ValueError(f"quota non valida per {name}")
        targets[name] = count
    missing = expected - set(targets)
    if missing:
        raise ValueError(f"mancano quote per: {', '.join(sorted(missing))}")
    samples_per_round = source.get("samples_per_round", 50)
    max_rounds = source.get("max_rounds_per_class", 12)
    if not isinstance(samples_per_round, int) or samples_per_round < 1:
        raise ValueError("samples_per_round deve essere positivo")
    if not isinstance(max_rounds, int) or max_rounds < 1:
        raise ValueError("max_rounds_per_class deve essere positivo")
    return targets, samples_per_round, max_rounds


def write_jsonl(path: Path, rows: list[dict[str, Any]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        "".join(json.dumps(row, ensure_ascii=False, separators=(",", ":")) + "\n" for row in rows),
        encoding="utf-8",
    )


def scoped_seed(row: dict[str, Any], category: str,
                specs: dict[str, dict[str, Any]]) -> dict[str, Any]:
    """Make the generator see only the requested callable tool.

    The final training rows are rehydrated with the complete catalogue below.
    Off-topic examples deliberately retain all tools: abstention is meaningful
    only when calls are actually available.
    """
    scoped = dict(row)
    scoped["tools"] = row["tools"] if category == OFF_TOPIC else [specs[category]]
    return scoped


def generate(seed: list[dict[str, Any]], count: int, model: str) -> list[dict[str, Any]]:
    key = os.environ.get("GEMINI_API_KEY")
    if not key:
        raise ValueError("imposta GEMINI_API_KEY da Google AI Studio")
    with tempfile.TemporaryDirectory(prefix="sparkie-distribution-") as directory:
        directory_path = Path(directory)
        seed_path = directory_path / "seed.jsonl"
        generated_path = directory_path / "generated.jsonl"
        write_jsonl(seed_path, seed)
        environment = dict(os.environ)
        environment["OPENROUTER_API_KEY"] = key
        environment["OPENROUTER_URL"] = GEMINI_ENDPOINT
        command = [
            str(ROOT / "runtime" / "venv" / "bin" / "needle"), "generate-data",
            "--augment", str(seed_path), "--num-samples", str(count), "--batch-size", str(count),
            "--workers", "1", "--model", model, "--output", str(generated_path),
        ]
        subprocess.run(command, check=True, env=environment)
        return load_jsonl(generated_path)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--input", type=Path, default=ROOT / "data" / "sparkie-tools.jsonl")
    parser.add_argument("--distribution", type=Path, default=ROOT / "data" / "distribution.json")
    parser.add_argument("--output", type=Path, default=ROOT / "data" / "sparkie-tools.augmented.jsonl")
    parser.add_argument("--seed-dir", type=Path,
                        default=ROOT / "data" / "augmentation-seeds",
                        help="Directory containing the audited per-class generator seeds.")
    parser.add_argument("--model", default="gemini-3.5-flash-lite")
    parser.add_argument("--dry-run", action="store_true", help="Report deficits without calling Gemini.")
    parser.add_argument("--prepare-seeds", action="store_true",
                        help="Write per-class generator seeds, then exit without calling Gemini.")
    args = parser.parse_args()

    responses = LocalResponseCatalog(ROOT / "responses.it.json")
    catalogue = ToolCatalog(ROOT / "tools.json", responses.intents)
    tools = catalogue.needle_tools
    specs = {tool["name"]: tool for tool in tools}
    targets, samples_per_round, max_rounds = load_distribution(
        args.distribution, set(specs),
    )

    accepted: dict[str, list[dict[str, Any]]] = {name: [] for name in targets}
    seen: set[tuple[str, str]] = set()
    for row in load_jsonl(args.input):
        if not is_valid(row, tools, responses, specs):
            raise ValueError(f"riga seed non valida: {row.get('query', '<senza query>')!r}")
        row["system"] = SYSTEM_FACTS
        category = row_class(row)
        if category not in targets:
            raise ValueError(f"seed con classe non dichiarata: {category}")
        key = row_key(row)
        if key not in seen and len(accepted[category]) < targets[category]:
            seen.add(key)
            accepted[category].append(row)

    for category, target in targets.items():
        print(f"{category}: {len(accepted[category])}/{target}")
    if args.dry_run:
        return 0

    # These files make the augmentation prompt reviewable. Each callable class
    # contains exactly one declared tool, so generation cannot drift into a
    # different tool merely because it was in the global catalogue.
    class_seeds: dict[str, list[dict[str, Any]]] = {}
    for category in targets:
        class_seeds[category] = [scoped_seed(row, category, specs)
                                 for row in accepted[category]]
        write_jsonl(args.seed_dir / f"{category}.jsonl", class_seeds[category])
    print(f"Wrote per-class seeds to {args.seed_dir}")
    if args.prepare_seeds:
        return 0

    for category, target in targets.items():
        if category == "local_smalltalk" and len(accepted[category]) < target:
            raise ValueError("local_smalltalk non viene inventato: aggiungi prima frasi approvate a responses.it.json")
        rounds = 0
        while len(accepted[category]) < target and rounds < max_rounds:
            deficit = target - len(accepted[category])
            request_count = min(samples_per_round, deficit)
            # The class-only seed biases Needle's generator; filtering below is
            # still mandatory because the model can emit another declared tool.
            generated = generate(class_seeds[category], request_count, args.model)
            kept = 0
            for row in generated:
                # Generator output intentionally has the class-specific schema;
                # train against the full schema advertised by the real gateway.
                row["tools"] = tools
                row["system"] = SYSTEM_FACTS
                if not is_valid(row, tools, responses, specs) or row_class(row) != category:
                    continue
                key = row_key(row)
                if key in seen or len(accepted[category]) >= target:
                    continue
                seen.add(key)
                accepted[category].append(row)
                kept += 1
            rounds += 1
            print(f"{category}: round {rounds}, accepted {kept}, {len(accepted[category])}/{target}")
        if len(accepted[category]) != target:
            raise RuntimeError(f"quota non raggiunta per {category}: {len(accepted[category])}/{target}")

    rows = [row for category in targets for row in accepted[category]]
    if Counter(row_class(row) for row in rows) != Counter(targets):
        raise RuntimeError("verifica finale delle quote fallita")
    write_jsonl(args.output, rows)
    print(f"Wrote {len(rows)} rows with exact distribution to {args.output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
